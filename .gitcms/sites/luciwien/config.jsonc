{
  "version": "1.2",
  "media": {
    "default_library": "repo_media",
    "libraries": [
      {
        "key": "repo_media",
        "label": "Repository media",
        "references": {
          "write": {
            "mode": "root_relative",
            "base_path": "/"
          },
          "allow_default_library_fallback": true
        },
        "limits": {
          "max_file_size_mb": 10
        },
        "driver": "git",
        "storage": {
          "root_path": "public"
        }
      }
    ]
  },
  "ssg_framework": "jekyll",
  "frontmatter_format": "yaml",
  "publishing_mode": "direct_publish",
  "collections": [
    {
      "name": "tarkeln",
      "git_path": "/_tarkeln",
      "file_extension": ".md",
      "filename_pattern": "_",
      "label": "Tarkeln",
      "frontmatter_schema": [
        {
          "name": "",
          "type": "text"
        }
      ]
    },
    {
      "name": "",
      "git_path": "",
      "file_extension": ".md",
      "filename_pattern": ""
    }
  ]
}
